# =============================================================================
# NutriWise AI – Environment Variables Template
# IBM watsonx.ai Credentials
# =============================================================================
# SETUP INSTRUCTIONS:
#   1. Copy this file and rename it to: .env
#   2. Replace the placeholder values with your actual IBM Cloud credentials
#   3. Never commit the .env file to version control
# =============================================================================

# Your IBM Cloud API key
# Get it from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Your IBM watsonx.ai Project ID
# Get it from: https://dataplatform.cloud.ibm.com → Your Project → Manage → General
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM watsonx.ai endpoint URL
# us-south  → https://us-south.ml.cloud.ibm.com
# eu-de     → https://eu-de.ml.cloud.ibm.com
# eu-gb     → https://eu-gb.ml.cloud.ibm.com
# jp-tok    → https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM watsonx.ai Model ID (e.g., ibm/granite-4-h-small or meta-llama/llama-3-3-70b-instruct)
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Flask settings (optional)
FLASK_ENV=development
FLASK_DEBUG=1
